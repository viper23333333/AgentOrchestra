# ============================================================================
# AgentOrchestra - Docker Ignore
# ============================================================================

# Version control
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml

# Documentation
*.md
LICENSE
docs/
*.txt

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Docker files (prevent recursive copies)
docker/
docker-compose*.yml
Dockerfile*
.dockerignore

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
eggs/
*.manifest
*.spec

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing and coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage/
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nox/

# Node.js artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next.js
.next/
out/

# Environment files
.env
.env.*
!.env.example
!.env.local.example

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp

# Data and database files
*.db
*.sqlite
*.sqlite3
data/

# Secrets
secrets/
*.pem
*.key
*.crt
*.p12
