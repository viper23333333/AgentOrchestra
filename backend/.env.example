# ============================================================
# AgentOrchestra - Environment Variables Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# cp .env.example .env
# ============================================================

# ---------- LLM Provider API Keys ----------
# At least one provider key is required for the system to work.

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0.7

# ---------- Default LLM Provider ----------
# Options: openai, anthropic, ollama
DEFAULT_LLM_PROVIDER=openai

# ---------- Redis Configuration ----------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# ---------- Database Configuration ----------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_orchestra

# ---------- Application Settings ----------
APP_NAME=AgentOrchestra
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-this-in-production

# ---------- CORS Configuration ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ---------- Server Configuration ----------
HOST=0.0.0.0
PORT=8000
WORKERS=1
